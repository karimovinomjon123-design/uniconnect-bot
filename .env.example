# ===============================================
# UniConnect Telegram Bot Sozlamalari
# ===============================================

# BotFather'dan olingan bot tokeni (Masalan: 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Administratorlarning Telegram ID raqamlari (vergul bilan ajratilgan)
# O'z ID raqamingizni bilish uchun Telegram'da @userinfobot ga /start bosing
ADMIN_IDS=123456789

# Majburiy a'zo bo'lish kanali username'i yoki ID raqami
REQUIRED_CHANNEL=@uniconnectuz_official
REQUIRED_CHANNEL_URL=https://t.me/uniconnectuz_official

# UniConnect rasmiy guruh va ijtimoiy tarmoqlar
GROUP_URL=https://t.me/uniconnect_uz
INSTAGRAM_URL=https://www.instagram.com/uniconnect_uz

# Ma'lumotlar bazasi fayli nomi
DB_NAME=uniconnect.db
